@model System.Text.Json.JsonElement
@using System.Text.Json

@{
    ViewData["Title"] = "Event Details - RACEDAY";

    string GetValue(string property)
    {
        if (Model.ValueKind == JsonValueKind.Object &&
            Model.TryGetProperty(property, out var value))
        {
            return value.ToString();
        }

        return "Not specified";
    }

    string title = GetValue("title");
    string description = GetValue("description");
    string eventDate = GetValue("eventDate");
    string startTime = GetValue("startTime");
    string location = GetValue("location");
    string distance = GetValue("distanceKm");
    string entryFee = GetValue("entryFee");
    string status = GetValue("statusOfEvent");

    
    DateOnly? selectedEventDate =
        DateOnly.TryParse(GetValue("eventDate"), out var parsedDate)
            ? parsedDate
            : null;

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
        "South Africa Standard Time");

    var southAfricanToday = DateOnly.FromDateTime(
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.UtcNow, saTimeZone));

    bool isEventToday = selectedEventDate == southAfricanToday;
    bool isPastEvent = selectedEventDate.HasValue &&
                       selectedEventDate.Value < southAfricanToday;

                       
    DateOnly? registrationOpens =
        DateOnly.TryParse(
            GetValue("registrationOpens"), out var opensDate)
            ? opensDate
            : null;

    DateOnly? registrationCloses =
        DateOnly.TryParse(
            GetValue("registrationCloses"), out var closesDate)
            ? closesDate
            : null;

    bool registrationNotOpen =
        registrationOpens.HasValue &&
        southAfricanToday < registrationOpens.Value;

    bool registrationClosed =
        registrationCloses.HasValue &&
        southAfricanToday > registrationCloses.Value;


}

<div class="container py-5">

    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="mb-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-4 p-md-5">

            <h1 class="fw-bold mb-3">@title</h1>

            <p class="lead text-muted">
                @description
            </p>

            <hr />

            <h4 class="mb-4">Event Information</h4>

            <div class="row g-4">
                <div class="col-md-6">
                    <strong>Event Date</strong>
                    <p>@eventDate</p>
                </div>

                <div class="col-md-6">
                    <strong>Start Time</strong>
                    <p>@startTime</p>
                </div>

                <div class="col-md-6">
                    <strong>Location</strong>
                    <p>@location</p>
                </div>

                <div class="col-md-6">
                    <strong>Distance</strong>
                    <p>@distance km</p>
                </div>

                <div class="col-md-6">
                    <strong>Entry Fee</strong>
                    <p>R @entryFee</p>
                </div>

                <div class="col-md-6">
                    <strong>Event Status</strong>
                    <p>@status</p>
                </div>
            </div>

            <hr />
            
            @{
                var categories = ViewBag.Categories as List<JsonElement>
                    ?? new List<JsonElement>();

                string GetCategoryValue(JsonElement category, string property)
                {
                    if (category.ValueKind == JsonValueKind.Object &&
                        category.TryGetProperty(property, out var value) &&
                        value.ValueKind != JsonValueKind.Null)
                    {
                        return value.ToString();
                    }

                    return "Not specified";
                }
            }

            <h4 class="mb-4">Available Event Categories</h4>

            @if (categories.Count == 0)
            {
                <div class="alert alert-info">
                    No categories are currently available for this event.
                </div>
            }
            else
            {
                <div class="row g-3 mb-4">
                    @foreach (var category in categories)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border rounded-3">
                                <div class="card-body">

                                    <h5 class="fw-bold">
                                        @GetCategoryValue(category, "categoryName")
                                    </h5>

                                    <p>
                                        @GetCategoryValue(category, "description")
                                    </p>

                                    <p>
                                        <strong>Distance:</strong>
                                        @GetCategoryValue(category, "distanceKm") km
                                    </p>

                                    <p>
                                        <strong>Minimum Age:</strong>
                                        @GetCategoryValue(category, "minAge")
                                    </p>

                                    <p>
                                        <strong>Maximum Age:</strong>
                                        @GetCategoryValue(category, "maxAge")
                                    </p>

                                    
                                   
                                    @if (isEventToday)
                                    {
                                        <div class="alert alert-info mb-0">
                                            Event is today.
                                        </div>
                                    }
                                    else if (isPastEvent)
                                    {
                                        <div class="alert alert-secondary mb-0">
                                            Event has ended.
                                        </div>
                                    }

                                    
                                    else if (registrationNotOpen)
                                    {
                                        <div class="alert alert-warning mb-0">
                                            Registration has not opened yet.
                                        </div>
                                    }
                                    else if (registrationClosed)
                                    {
                                        <div class="alert alert-secondary mb-0">
                                            Registration closed.
                                        </div>
                                    }

                                    else if (User.Identity?.IsAuthenticated == true &&
                                             User.IsInRole("Participant"))
                                    {
                                        if (int.TryParse(
                                            GetCategoryValue(category, "eventCategoryID") != "Not specified"
                                                ? GetCategoryValue(category, "eventCategoryID")
                                                : GetCategoryValue(category, "eventCategoryId"),
                                            out int categoryId) &&
                                            int.TryParse(
                                                GetValue("eventID") != "Not specified"
                                                    ? GetValue("eventID")
                                                    : GetValue("eventId"),
                                                out int eventId))
                                        {
                                            <form asp-controller="Enrolment"
                                                  asp-action="Create"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="eventId"
                                                       value="@eventId" />

                                                <input type="hidden"
                                                       name="eventCategoryId"
                                                       value="@categoryId" />

                                                <button type="submit"
                                                        class="btn btn-success w-100">
                                                    Enrol Now
                                                </button>
                                            </form>
                                        }
                                    }


                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <hr />

            
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p class="text-muted">
                    Please log in to enrol in this event.
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-dark">
                    Login to Enrol
                </a>
            }

        </div>
    </div>
</div>
