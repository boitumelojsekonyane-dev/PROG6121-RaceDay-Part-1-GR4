@{
    ViewData["Title"] = "Delete Event";

    int eventId = ViewBag.EventID;
    string eventTitle = ViewBag.EventTitle ?? "Unknown Event";
}

<div class="container mt-4 mb-5">

    <h2 class="text-danger">Delete RaceDay Event</h2>

    <div class="alert alert-warning mt-3">
        <strong>Warning!</strong>
        You are about to permanently delete an event.
        This action cannot be undone.
    </div>

    <div class="card mt-4">
        <div class="card-body">

            <h4 class="card-title">@eventTitle</h4>

            <p class="card-text">
                Are you sure you want to delete this event?
            </p>

            <form asp-controller="Organiser"
                  asp-action="DeleteEvent"
                  asp-route-id="@eventId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Event
                </button>

                <a asp-controller="Organiser"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
