{
    "ConnectionStrings": {
        "RaceDayConnection": "Server=(localdb)\\mssqllocaldb;Database=RaceDayActivitiesDb;Trusted_Connection=true;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Issuer": "RaceDay.API",
        "Audience": "RaceDay.Client",
        "ExpiryMinutes": 60
    },
    "AzureStorage": {
        "ConnectionString": "UseDevelopmentStorage=true",
        "ContainerName": "event-images"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
