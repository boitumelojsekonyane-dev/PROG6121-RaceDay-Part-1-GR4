@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">
            RACEDAY Organiser Dashboard
        </h1>

        <p class="lead">
            @ViewBag.Message
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Manage Events</h3>
                    <p>
                        Create, edit and delete
                        your sporting events.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Event Categories</h3>
                    <p>
                        Manage age groups and
                        distance categories.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Enrolments</h3>
                    <p>
                        View participants registered
                        for your events.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Race Results</h3>
                    <p>
                        Capture and publish race
                        results after events.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

    </div>

</div>
