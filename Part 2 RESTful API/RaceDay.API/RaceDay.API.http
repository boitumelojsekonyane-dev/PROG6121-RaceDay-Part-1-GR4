
@RaceDay.API_HostAddress = https://localhost:7255
@jwtToken = PARTICIPANTS_TOKEN
GET {{RaceDay.API_HostAddress}}/api/events
Accept: application/json

###

POST {{RaceDay.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Test",
  "surname": "Runner",
  "email": "testrunner01@example.com",
  "userName": "testrunner01",
  "phoneNumber": "0712345678",
  "emergencyContact": "0723456789",
  "dateOfBirth": "2000-05-15",
  "identityNumber": null,
  "passportNumber": "TESTPASS001",
  "gender": "Female",
  "province": "Gauteng",
  "password": "REPLACE_WITH_ACTUAL_PASSWORD",
  "confirmPassword": "REPLACE_WITH_ACTUAL_CONFIRM_PASSWORD" 
}

###


###

POST {{RaceDay.API_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "testrunner01@example.com",
  "password": "PARTICIPANTS_PASSWORD"
}

###


###

//Test for unauthorized access to the participant endpoint
GET {{RaceDay.API_HostAddress}}/api/auth-test/participant
Accept: application/json

###

###

//Test for authorized access to the participant endpoint
GET {{RaceDay.API_HostAddress}}/api/auth-test/participant
Authorization: Bearer {{jwtToken}}
Accept: application/json

###

###
//Test for authorized access to the admin endpoint
POST https://localhost:7255/api/enrolments
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{
  "eventCategoryId": 2
}

