@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">
            RACEDAY Participant Dashboard
        </h1>

        <p class="lead">
            @ViewBag.Message
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Discover Events</h3>
                    <p>
                        Explore upcoming running,
                        walking and cycling events.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">My Enrolments</h3>
                    <p>
                        View your registered events
                        and enrolment statuses.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">My Results</h3>
                    <p>
                        Track your race history,
                        finish times and positions.
                    </p>
                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>
                </div>
            </div>
        </div>

    </div>

</div>
