            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "location": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "distanceKm": {
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "registrationOpens": {
            "type": "string",
            "format": "date"
          },
          "registrationCloses": {
            "type": "string",
            "format": "date"
          },
          "entryFee": {
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateResultRequest": {
        "required": [
          "finishTime"
